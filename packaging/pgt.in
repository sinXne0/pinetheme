#!/usr/bin/env bash
# pgt — launch the Pager Theme Builder.
set -euo pipefail

APP_DIR="${PGT_APP_DIR:-__APP_DIR__}"

if [[ ! -d "$APP_DIR" ]]; then
  echo "pgt: app directory not found: $APP_DIR" >&2
  exit 1
fi

if [[ ! -x "$APP_DIR/node_modules/.bin/electron" ]]; then
  echo "pgt: Electron is not installed. Run:" >&2
  echo "  cd \"$APP_DIR\" && npm install" >&2
  exit 1
fi

cd "$APP_DIR"
exec "$APP_DIR/node_modules/.bin/electron" "$APP_DIR" "$@"
